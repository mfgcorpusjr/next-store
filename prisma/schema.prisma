generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id String @id @default(uuid())
  name String
  company String
  price Int
  image String
  description String
  isFeatured Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}